---
import Stage from '../Stage.astro'
import SectionLine from '../parts/SectionLine.astro'
import Headline from '../parts/Headline.astro'
import SectionIndex from '../parts/SectionIndex.astro'
import '../../../styles/sections/work.css'
const stations = [
  { name: 'Web search', x: 66, w: 172, center: 152 },
  { name: 'Presentation', x: 274, w: 258, center: 408 },
  { name: 'Word', x: 566, w: 152, center: 642 },
  { name: 'Excel', x: 752, w: 172, center: 838 },
  { name: 'Whiteboard', x: 982, w: 242, center: 1108 },
  { name: 'Gmail', x: 1256, w: 248, center: 1378 },
]
---

<Stage id="work" class="work" label="Your work">
  <SectionLine
    path="M218 0 V160 H162 V478 A40 40 0 0 1 122 518 H78 A40 40 0 0 0 38 558 V786 A38 38 0 0 0 76 824 H1378 A26 26 0 0 1 1404 850 V928 A26 26 0 0 1 1378 954 H248 A30 30 0 0 0 218 984 V1024"
    mobilePath="M24 0 V234 A28 28 0 0 0 52 262 V1980 A24 24 0 0 0 76 2004 H342 A24 24 0 0 1 366 2028 V2062 A24 24 0 0 1 342 2086 H48 A24 24 0 0 0 24 2110"
    mobileHeight={2110}
  >
    <g slot="desktop" fill="var(--bg)" stroke="var(--blue)" stroke-width="3">
      {stations.map(({ center }) => (
        <g>
          <path d={`M${center} 760 V824`} />
          <circle cx={center} cy="824" r="10" />
        </g>
      ))}
      <rect
        data-work-train
        x="140"
        y="812"
        width="24"
        height="24"
        fill="var(--blue)"
        stroke="none"
      />
    </g>
    <g slot="mobile">
      <rect data-work-train x="40" y="286" width="24" height="24" fill="var(--blue)" />
    </g>
  </SectionLine>
  <SectionIndex index={5} style="--x:42;--y:44;--w:150" />
  <Headline lines={['The rest', 'of your day.']} class="work-headline" />
  <div class="work-stations">
    {stations.map(({ name, x, w }, i) => (
      <article
        class={`work-station work-station-${i} canvas-item`}
        style={`--x:${x};--y:568;--w:${w}`}
      >
        <div class="work-document" data-work-document data-reveal>
          {i === 0 && (
            <>
              <div class="work-browser-chrome">
                <i></i>
                <i></i>
                <i></i>
              </div>
              <div class="work-search-field">
                <svg viewBox="0 0 20 20" aria-hidden="true">
                  <circle cx="8" cy="8" r="5" />
                  <path d="M12 12 L18 18" />
                </svg>
                <span>Sources</span>
              </div>
              <div class="work-source">
                <u>Project notes</u>
                <i></i>
                <i></i>
                <i></i>
              </div>
              <div class="work-source">
                <u>Team handbook</u>
                <i></i>
                <i></i>
                <i></i>
              </div>
              <div class="work-source">
                <u>Weekly update</u>
                <i></i>
                <i></i>
              </div>
            </>
          )}
          {i === 1 && (
            <div class="work-presentation">
              <div class="work-slide-rail">
                <b></b>
                <i></i>
                <i></i>
              </div>
              <div class="work-slide">
                <b>Weekly review</b>
                <i></i>
                <i></i>
                <i></i>
                <div class="work-bars">
                  <span></span>
                  <span></span>
                  <span></span>
                </div>
              </div>
            </div>
          )}
          {i === 2 && (
            <div class="work-word">
              <b>Meeting notes</b>
              {Array.from({ length: 11 }, () => (
                <i></i>
              ))}
            </div>
          )}
          {i === 3 && (
            <div class="work-sheet" aria-label="Sample spreadsheet">
              <div class="work-sheet-head">
                <span>A</span>
                <span>B</span>
                <span>C</span>
              </div>
              {['Research', 'Draft', 'Review', 'Send', '', '', '', ''].map((label, j) => (
                <div>
                  <span>{j + 1}</span>
                  <span>{label}</span>
                  <span></span>
                </div>
              ))}
            </div>
          )}
          {i === 4 && (
            <svg
              class="work-whiteboard"
              viewBox="0 0 242 190"
              aria-hidden="true"
              fill="none"
              stroke="currentColor"
            >
              <path d="M16 34 H74 V68 H16 Z M104 34 H157 V68 H104 Z M73 50 H102 M96 45 L102 50 L96 55 M48 68 V110 H86 M80 105 L86 110 L80 115 M86 93 H154 V126 H86 Z" />
              <circle cx="196" cy="102" r="33" />
              <path d="M196 69 V102 H229" fill="var(--blue-tint)" />
            </svg>
          )}
          {i === 5 && (
            <div class="work-mail">
              <svg viewBox="0 0 30 20" aria-hidden="true">
                <path d="M1 1 H29 V19 H1 Z M1 1 L15 12 L29 1" />
              </svg>
              <p>To: project team</p>
              <b>Monday update</b>
              <p>
                The weekly review is ready.
                <br />
                Please find the notes and
                <br />
                next steps attached.
              </p>
              <div class="work-mail-lines">
                <i></i>
                <i></i>
                <i></i>
              </div>
              <strong>Shall I send this draft?</strong>
            </div>
          )}
        </div>
        <h3>{name}</h3>
      </article>
    ))}
  </div>
  <div class="work-timetable canvas-item" data-noverlap>
    <span class="work-sample">Sample data</span>
    <p>
      Every Monday at{' '}
      <span class="work-digit-window">
        <span data-work-digits>08:00</span>
      </span>{' '}
      · Check my intranet · Next: Nov 9
    </p>
  </div>
  <p class="sr-only">
    A transit line connects web research, presentations, documents, spreadsheets, whiteboards and
    email. The email remains a draft awaiting confirmation. The timetable is sample data.
  </p>
</Stage>
