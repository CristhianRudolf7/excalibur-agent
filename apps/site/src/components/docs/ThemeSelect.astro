---
const spanish = Astro.locals.starlightRoute.lang === 'es'
---

<button
  class="manual-theme"
  data-theme-toggle
  hidden
  aria-label={spanish ? 'Cambiar tema' : 'Switch theme'}
>
  <svg
    viewBox="0 0 24 24"
    width="20"
    height="20"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    aria-hidden="true"
  >
    <path d="M12 3v3m0 12v3M3 12h3m12 0h3M5.6 5.6l2.1 2.1m8.6 8.6 2.1 2.1M5.6 18.4l2.1-2.1m8.6-8.6 2.1-2.1" />
    <circle cx="12" cy="12" r="4" />
  </svg>
</button>
