{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "collections.json",
  "$defs": {
    "FieldType": {
      "enum": [
        "text",
        "long_text",
        "number",
        "integer",
        "money",
        "date",
        "datetime",
        "boolean",
        "select",
        "multi_select",
        "relation",
        "email",
        "url",
        "file"
      ]
    },
    "Field": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/FieldType"
        },
        "required": {
          "type": "boolean"
        },
        "unique": {
          "type": "boolean"
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "currency": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "description": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "type"
      ],
      "additionalProperties": false
    },
    "Filter": {
      "type": "object",
      "properties": {
        "field": {
          "type": "string"
        },
        "op": {
          "enum": [
            "eq",
            "neq",
            "lt",
            "lte",
            "gt",
            "gte",
            "contains",
            "in",
            "is_empty",
            "not_empty"
          ]
        },
        "value": {}
      },
      "required": [
        "field",
        "op"
      ],
      "additionalProperties": false
    },
    "SummaryCard": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "count",
            "sum",
            "avg",
            "min",
            "max",
            "weighted_avg"
          ]
        },
        "field": {
          "type": "string"
        },
        "weight_field": {
          "type": "string"
        },
        "filter": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Filter"
          }
        },
        "group_by": {
          "type": "string"
        },
        "chart": {
          "enum": [
            "none",
            "bar",
            "line",
            "pie"
          ]
        }
      },
      "required": [
        "id",
        "title",
        "kind"
      ],
      "additionalProperties": false
    },
    "Collection": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "icon": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Field"
          }
        },
        "display_field": {
          "type": "string"
        },
        "summary": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SummaryCard"
          }
        },
        "record_count": {
          "type": "integer"
        },
        "created_at": {
          "type": "string"
        },
        "updated_at": {
          "type": "string"
        },
        "version": {
          "type": "integer"
        }
      },
      "required": [
        "id",
        "name",
        "fields",
        "display_field",
        "record_count",
        "created_at",
        "updated_at",
        "version"
      ],
      "additionalProperties": false
    },
    "RecordRow": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "values": {
          "type": "object"
        },
        "created_at": {
          "type": "string"
        },
        "updated_at": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "values",
        "created_at",
        "updated_at"
      ],
      "additionalProperties": false
    },
    "ImportMapping": {
      "type": "object",
      "properties": {
        "column": {
          "type": "string"
        },
        "field": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "column",
        "field"
      ],
      "additionalProperties": false
    },
    "ImportConflict": {
      "type": "object",
      "properties": {
        "row": {
          "type": "integer"
        },
        "column": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "problem": {
          "enum": [
            "invalid_type",
            "required_missing",
            "duplicate",
            "unknown_option",
            "out_of_range",
            "ambiguous_date",
            "relation_not_found"
          ]
        },
        "suggestion": {
          "type": "string"
        }
      },
      "required": [
        "row",
        "column",
        "value",
        "problem"
      ],
      "additionalProperties": false
    },
    "ImportFix": {
      "type": "object",
      "properties": {
        "row": {
          "type": "integer"
        },
        "column": {
          "type": "string"
        },
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "rule": {
          "type": "string"
        }
      },
      "required": [
        "row",
        "column",
        "from",
        "to",
        "rule"
      ],
      "additionalProperties": false
    },
    "ImportReport": {
      "type": "object",
      "properties": {
        "dry_run": {
          "type": "boolean"
        },
        "total_rows": {
          "type": "integer"
        },
        "imported": {
          "type": "integer"
        },
        "skipped": {
          "type": "integer"
        },
        "updated": {
          "type": "integer"
        },
        "mapping": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ImportMapping"
          }
        },
        "unknown_columns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "conflicts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ImportConflict"
          }
        },
        "fixes_applied": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ImportFix"
          }
        },
        "pending_rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ImportPendingRow"
          }
        }
      },
      "required": [
        "dry_run",
        "total_rows",
        "imported",
        "skipped",
        "updated",
        "mapping",
        "unknown_columns",
        "conflicts",
        "fixes_applied"
      ],
      "additionalProperties": false
    },
    "Empty": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "CollectionID": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "CollectionResult": {
      "type": "object",
      "properties": {
        "collection": {
          "$ref": "#/$defs/Collection"
        }
      },
      "required": [
        "collection"
      ],
      "additionalProperties": false
    },
    "RecordResult": {
      "type": "object",
      "properties": {
        "record": {
          "$ref": "#/$defs/RecordRow"
        }
      },
      "required": [
        "record"
      ],
      "additionalProperties": false
    },
    "OK": {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean"
        }
      },
      "required": [
        "ok"
      ],
      "additionalProperties": false
    },
    "ListCollections": {
      "type": "object",
      "properties": {
        "collections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Collection"
          }
        }
      },
      "required": [
        "collections"
      ],
      "additionalProperties": false
    },
    "CreateCollection": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "icon": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Field"
          }
        },
        "display_field": {
          "type": "string"
        },
        "summary": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SummaryCard"
          }
        }
      },
      "required": [
        "name",
        "fields"
      ],
      "additionalProperties": false
    },
    "UpdateCollection": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "icon": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "summary": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SummaryCard"
          }
        },
        "display_field": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "AlterFields": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "add": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Field"
          }
        },
        "rename": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "field": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            },
            "required": [
              "field",
              "name"
            ],
            "additionalProperties": false
          }
        },
        "remove": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "change_type": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "field": {
                "type": "string"
              },
              "type": {
                "$ref": "#/$defs/FieldType"
              },
              "options": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "field",
              "type"
            ],
            "additionalProperties": false
          }
        },
        "dry_run": {
          "type": "boolean"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "AlterFieldsResult": {
      "type": "object",
      "properties": {
        "collection": {
          "$ref": "#/$defs/Collection"
        },
        "report": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "field": {
                "type": "string"
              },
              "converted": {
                "type": "integer"
              },
              "failed": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "record_id": {
                      "type": "string"
                    },
                    "value": {}
                  },
                  "required": [
                    "record_id",
                    "value"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "field",
              "converted",
              "failed"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "collection"
      ],
      "additionalProperties": false
    },
    "ListRecords": {
      "type": "object",
      "properties": {
        "collection": {
          "type": "string"
        },
        "query": {
          "type": "string"
        },
        "filters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Filter"
          }
        },
        "sort": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "field": {
                "type": "string"
              },
              "dir": {
                "enum": [
                  "asc",
                  "desc"
                ]
              }
            },
            "required": [
              "field",
              "dir"
            ],
            "additionalProperties": false
          }
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "cursor": {
          "type": "string"
        }
      },
      "required": [
        "collection"
      ],
      "additionalProperties": false
    },
    "ListRecordsResult": {
      "type": "object",
      "properties": {
        "records": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RecordRow"
          }
        },
        "total": {
          "type": "integer"
        },
        "next_cursor": {
          "type": "string"
        }
      },
      "required": [
        "records",
        "total"
      ],
      "additionalProperties": false
    },
    "RecordID": {
      "type": "object",
      "properties": {
        "collection": {
          "type": "string"
        },
        "id": {
          "type": "string"
        }
      },
      "required": [
        "collection",
        "id"
      ],
      "additionalProperties": false
    },
    "GetRecordResult": {
      "type": "object",
      "properties": {
        "record": {
          "$ref": "#/$defs/RecordRow"
        },
        "related": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "collection": {
                "type": "string"
              },
              "field": {
                "type": "string"
              },
              "records": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/RecordRow"
                }
              }
            },
            "required": [
              "collection",
              "field",
              "records"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "record",
        "related"
      ],
      "additionalProperties": false
    },
    "CreateRecord": {
      "type": "object",
      "properties": {
        "collection": {
          "type": "string"
        },
        "values": {
          "type": "object"
        }
      },
      "required": [
        "collection",
        "values"
      ],
      "additionalProperties": false
    },
    "UpdateRecord": {
      "type": "object",
      "properties": {
        "collection": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "values": {
          "type": "object"
        }
      },
      "required": [
        "collection",
        "id",
        "values"
      ],
      "additionalProperties": false
    },
    "SummaryResult": {
      "type": "object",
      "properties": {
        "cards": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "value": {},
              "unit": {
                "type": "string"
              },
              "series": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "label": {
                      "type": "string"
                    },
                    "value": {}
                  },
                  "required": [
                    "label",
                    "value"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "id",
              "title",
              "value"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "cards"
      ],
      "additionalProperties": false
    },
    "Import": {
      "type": "object",
      "properties": {
        "collection": {
          "type": "string"
        },
        "blob_digest": {
          "type": "string"
        },
        "sheet": {
          "type": "string"
        },
        "mapping": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ImportMapping"
          }
        },
        "create_schema": {
          "type": "boolean"
        },
        "upsert_key": {
          "type": "string"
        },
        "fixes": {
          "enum": [
            "auto",
            "none"
          ]
        },
        "dry_run": {
          "type": "boolean"
        },
        "overrides": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ImportOverride"
          }
        },
        "skip_rows": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        }
      },
      "required": [
        "blob_digest"
      ],
      "additionalProperties": false
    },
    "ImportResult": {
      "type": "object",
      "properties": {
        "collection": {
          "$ref": "#/$defs/Collection"
        },
        "report": {
          "$ref": "#/$defs/ImportReport"
        },
        "proposed_fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Field"
          }
        }
      },
      "required": [
        "report"
      ],
      "additionalProperties": false
    },
    "Export": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "format": {
          "enum": [
            "xlsx",
            "csv"
          ]
        },
        "filters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Filter"
          }
        }
      },
      "required": [
        "id",
        "format"
      ],
      "additionalProperties": false
    },
    "ExportResult": {
      "type": "object",
      "properties": {
        "blob_digest": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "mime": {
          "type": "string"
        }
      },
      "required": [
        "blob_digest",
        "name",
        "mime"
      ],
      "additionalProperties": false
    },
    "Changed": {
      "type": "object",
      "properties": {
        "collection": {
          "type": "string"
        },
        "record_id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        }
      },
      "required": [
        "collection",
        "kind"
      ],
      "additionalProperties": false
    },
    "ImportPendingRow": {
      "type": "object",
      "properties": {
        "row": {
          "type": "integer"
        },
        "values": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "row",
        "values",
        "reason"
      ],
      "additionalProperties": false
    },
    "ImportOverride": {
      "type": "object",
      "properties": {
        "row": {
          "type": "integer"
        },
        "column": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "row",
        "column",
        "value"
      ],
      "additionalProperties": false
    }
  }
}
