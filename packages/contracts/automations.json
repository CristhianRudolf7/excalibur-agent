{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "AutomationSchedule": {
      "type": "object",
      "required": [
        "kind",
        "timezone"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "once",
            "interval",
            "daily",
            "weekly",
            "monthly",
            "cron"
          ]
        },
        "timezone": {
          "type": "string"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "every_minutes": {
          "type": "integer",
          "minimum": 5
        },
        "time": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "weekdays": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 6
          }
        },
        "day_of_month": {
          "type": "integer",
          "minimum": 1,
          "maximum": 31
        },
        "cron": {
          "type": "string"
        }
      }
    },
    "AutomationStep": {
      "type": "object",
      "required": [
        "id",
        "type",
        "title"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "agent",
            "script",
            "tool",
            "condition",
            "notify"
          ]
        },
        "title": {
          "type": "string"
        },
        "instruction": {
          "type": "string"
        },
        "language": {
          "type": "string",
          "enum": [
            "python",
            "node",
            "bash"
          ]
        },
        "code": {
          "type": "string"
        },
        "tool": {
          "type": "string"
        },
        "args": {
          "type": "object"
        },
        "expression": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      }
    },
    "AutomationEdge": {
      "type": "object",
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "label": {
          "type": "string",
          "enum": [
            "yes",
            "no"
          ]
        }
      }
    },
    "AutomationStepRun": {
      "type": "object",
      "required": [
        "step_id",
        "status"
      ],
      "properties": {
        "step_id": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "running",
            "succeeded",
            "failed",
            "skipped"
          ]
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "finished_at": {
          "type": "string",
          "format": "date-time"
        },
        "output_preview": {
          "type": "string",
          "maxLength": 2000
        },
        "error": {
          "type": "string"
        }
      }
    },
    "AutomationRun": {
      "type": "object",
      "required": [
        "id",
        "automation_id",
        "version",
        "trigger",
        "status",
        "started_at",
        "steps"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "automation_id": {
          "type": "string"
        },
        "version": {
          "type": "integer"
        },
        "trigger": {
          "type": "string",
          "enum": [
            "schedule",
            "manual",
            "catch_up"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "running",
            "succeeded",
            "failed",
            "cancelled"
          ]
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "finished_at": {
          "type": "string",
          "format": "date-time"
        },
        "summary": {
          "type": "string"
        },
        "error": {
          "type": "string"
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AutomationStepRun"
          }
        }
      }
    },
    "AutomationVersion": {
      "type": "object",
      "required": [
        "version",
        "created_at"
      ],
      "properties": {
        "version": {
          "type": "integer"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "Automation": {
      "type": "object",
      "required": [
        "id",
        "name",
        "description",
        "status",
        "version",
        "schedule",
        "steps",
        "edges",
        "consecutive_failures",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "paused"
          ]
        },
        "paused_reason": {
          "type": "string"
        },
        "version": {
          "type": "integer"
        },
        "schedule": {
          "$ref": "#/$defs/AutomationSchedule"
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AutomationStep"
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AutomationEdge"
          }
        },
        "next_run_at": {
          "type": "string",
          "format": "date-time"
        },
        "last_run": {
          "$ref": "#/$defs/AutomationRun"
        },
        "consecutive_failures": {
          "type": "integer"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
