{
  "version": 0,
  "description": "Excalibur typed bus events. Exported from internal/api EventTypes; do not edit by hand without updating the registry.",
  "events": [
    {
      "type": "agents.created",
      "payload": "Agent",
      "summary": "A personal agent was created."
    },
    {
      "type": "agents.updated",
      "payload": "Agent",
      "summary": "A personal agent changed."
    },
    {
      "type": "agents.archived",
      "payload": "Agent",
      "summary": "A personal agent was archived."
    },
    {
      "type": "agents.restored",
      "payload": "Agent",
      "summary": "A personal agent was restored."
    },
    {
      "type": "agents.favorite_changed",
      "payload": "AgentsFavoriteResult",
      "summary": "The default agent changed."
    },
    {
      "type": "agents.unread",
      "payload": "AgentsUnreadEvent",
      "summary": "Agent unread count or latest message changed."
    },
    {
      "type": "robot.state",
      "payload": "RobotStateEvent",
      "summary": "Robot state changed or connected heartbeat."
    },
    {
      "type": "artifact.created",
      "payload": "ArtifactCreatedEvent",
      "summary": "A visual artifact was persisted."
    },
    {
      "type": "artifact.ready",
      "payload": "ArtifactReadyEvent",
      "summary": "A turn finished with visual artifacts."
    },
    {
      "type": "robotlab.frame",
      "payload": "RobotLabFrame",
      "summary": "Robot Lab frame."
    },
    {
      "type": "robotlab.metrics",
      "payload": "RobotLabMetricsEvent",
      "summary": "Robot Lab metrics."
    },
    {
      "type": "robotlab.experiment",
      "payload": "RobotLabExperiment",
      "summary": "Robot Lab experiment."
    },
    {
      "type": "robotlab.log",
      "payload": "RobotLabLogEvent",
      "summary": "Robot Lab log."
    },
    {
      "type": "robotlab.install",
      "payload": "RobotLabInstallEvent",
      "summary": "Robot Lab install."
    },
    {
      "type": "robotlab.vision",
      "payload": "RobotLabVisionEvent",
      "summary": "Robot Lab vision."
    },
    {
      "type": "robotlab.focus",
      "payload": "RobotLabFocusEvent",
      "summary": "Robot Lab focus."
    },
    {
      "type": "robotlab.teleop",
      "payload": "RobotLabTeleopEvent",
      "summary": "Robot Lab teleop."
    },
    {
      "type": "activity.updated",
      "payload": "ActivityUpdatedEvent",
      "summary": "Conversation activity changed."
    },
    {
      "type": "task.updated",
      "payload": "TaskUpdatedEvent",
      "summary": "A task changed."
    },
    {
      "type": "reminder.updated",
      "payload": "ReminderEvent",
      "summary": "A reminder changed."
    },
    {
      "type": "reminder.fired",
      "payload": "ReminderEvent",
      "summary": "A reminder fired."
    },
    {
      "type": "classroom.course_created",
      "payload": "ClassroomCourseEvent",
      "summary": "A course was created."
    },
    {
      "type": "classroom.course_updated",
      "payload": "ClassroomCourseEvent",
      "summary": "A course changed or was deleted."
    },
    {
      "type": "classroom.class_requested",
      "payload": "ClassroomEvent",
      "summary": "A topic needs a lesson."
    },
    {
      "type": "classroom.class_ready",
      "payload": "ClassroomClassReadyEvent",
      "summary": "A topic lesson was stored."
    },
    {
      "type": "classroom.quiz_requested",
      "payload": "ClassroomEvent",
      "summary": "A new quiz is needed."
    },
    {
      "type": "classroom.quiz_ready",
      "payload": "ClassroomQuizReadyEvent",
      "summary": "A quiz is ready without answer keys."
    },
    {
      "type": "classroom.attempt_graded",
      "payload": "ClassroomAttemptGradedEvent",
      "summary": "A quiz attempt was graded."
    },
    {
      "type": "classroom.feedback_ready",
      "payload": "ClassroomFeedbackReadyEvent",
      "summary": "Attempt feedback was stored."
    },
    {
      "type": "classroom.topic_completed",
      "payload": "ClassroomTopicCompletedEvent",
      "summary": "A topic was completed."
    },
    {
      "type": "classroom.course_completed",
      "payload": "ClassroomCourseEvent",
      "summary": "The final exam was passed."
    },
    {
      "type": "whiteboard.opened",
      "payload": "WhiteboardOpenedEvent",
      "summary": "Whiteboard opened."
    },
    {
      "type": "whiteboard.ops",
      "payload": "WhiteboardOpsEvent",
      "summary": "Whiteboard ops."
    },
    {
      "type": "whiteboard.focus",
      "payload": "WhiteboardFocusEvent",
      "summary": "Whiteboard focus."
    },
    {
      "type": "whiteboard.highlight",
      "payload": "WhiteboardHighlightEvent",
      "summary": "Whiteboard highlight."
    },
    {
      "type": "whiteboard.snapshot_requested",
      "payload": "WhiteboardSnapshotRequestedEvent",
      "summary": "Whiteboard snapshot requested."
    },
    {
      "type": "whiteboard.closed",
      "payload": "WhiteboardEvent",
      "summary": "Whiteboard closed."
    },
    {
      "type": "library.document_updated",
      "payload": "DocumentInfo",
      "summary": "A library document changed."
    },
    {
      "type": "message.created",
      "payload": "MessageEvent",
      "summary": "A message was persisted."
    },
    {
      "type": "run.state_changed",
      "payload": "RunProgressEvent",
      "summary": "A run changed state."
    },
    {
      "type": "run.progress",
      "payload": "RunProgressEvent",
      "summary": "Run progress update."
    },
    {
      "type": "plan.approval_requested",
      "payload": "PlanApprovalEvent",
      "summary": "A macro plan needs approval."
    },
    {
      "type": "question.asked",
      "payload": "QuestionEvent",
      "summary": "A question needs an answer."
    },
    {
      "type": "notice.posted",
      "payload": "NoticeEvent",
      "summary": "A notice was posted."
    },
    {
      "type": "metric.recorded",
      "payload": "MetricEvent",
      "summary": "A metric sample was recorded."
    },
    {
      "type": "tool.called",
      "payload": "ToolCallEvent",
      "summary": "A tool call started."
    },
    {
      "type": "tool.completed",
      "payload": "ToolCallEvent",
      "summary": "A tool call finished."
    },
    {
      "type": "memory.written",
      "payload": "MemoryEvent",
      "summary": "A memory was written."
    },
    {
      "type": "compaction.completed",
      "payload": "CompactionEvent",
      "summary": "Context compaction completed."
    },
    {
      "type": "loop.detected",
      "payload": "LoopEvent",
      "summary": "The loop detector fired."
    },
    {
      "type": "directive.sent",
      "payload": "DirectiveEvent",
      "summary": "A directive was sent."
    },
    {
      "type": "file.edited",
      "payload": "FileEditEvent",
      "summary": "A file was edited, with diff."
    },
    {
      "type": "error.occurred",
      "payload": "ErrorEvent",
      "summary": "An error occurred."
    },
    {
      "type": "automation.updated",
      "payload": "AutomationEvent",
      "summary": "An automation changed."
    },
    {
      "type": "automation.deleted",
      "payload": "AutomationDeletedEvent",
      "summary": "An automation was deleted."
    },
    {
      "type": "automation.run",
      "payload": "AutomationRunEvent",
      "summary": "An automation run changed."
    },
    {
      "type": "credentials.requested",
      "payload": "CredentialsRequestedEvent",
      "summary": "A run needs secure credentials."
    },
    {
      "type": "credentials.resolved",
      "payload": "CredentialsResolvedEvent",
      "summary": "A secure credential request was resolved."
    }
  ],
  "$defs": {
    "RobotStateEvent": {
      "type": "object",
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "$ref": "methods.json#/$defs/RobotState"
        }
      }
    },
    "Artifact": {
      "type": "object",
      "required": [
        "id",
        "conversation_id",
        "run_id",
        "tool_call_id",
        "kind",
        "title",
        "format",
        "mime",
        "created_at",
        "url_or_path",
        "size"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "conversation_id": {
          "type": "string"
        },
        "run_id": {
          "type": "string"
        },
        "tool_call_id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "format": {
          "enum": [
            "svg",
            "png",
            "pdf"
          ]
        },
        "dialect": {
          "type": "string"
        },
        "group": {
          "type": "string"
        },
        "mime": {
          "type": "string"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "url_or_path": {
          "type": "string"
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8388608
        }
      }
    },
    "ArtifactCreatedEvent": {
      "type": "object",
      "required": [
        "conversation_id",
        "run_id",
        "artifact"
      ],
      "properties": {
        "conversation_id": {
          "type": "string"
        },
        "run_id": {
          "type": "string"
        },
        "artifact": {
          "$ref": "#/$defs/Artifact"
        }
      }
    },
    "ArtifactReadyEvent": {
      "type": "object",
      "required": [
        "conversation_id",
        "run_id",
        "artifacts"
      ],
      "properties": {
        "conversation_id": {
          "type": "string"
        },
        "run_id": {
          "type": "string"
        },
        "artifacts": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/Artifact"
          }
        }
      }
    },
    "RobotLabFrame": {
      "$ref": "robotlab.json#/$defs/Frame"
    },
    "RobotLabMetricsEvent": {
      "$ref": "robotlab.json#/$defs/MetricsEvent"
    },
    "RobotLabExperiment": {
      "$ref": "robotlab.json#/$defs/Experiment"
    },
    "RobotLabLogEvent": {
      "$ref": "robotlab.json#/$defs/LogEvent"
    },
    "RobotLabInstallEvent": {
      "$ref": "robotlab.json#/$defs/InstallEvent"
    },
    "RobotLabVisionEvent": {
      "$ref": "robotlab.json#/$defs/VisionEvent"
    },
    "RobotLabFocusEvent": {
      "$ref": "robotlab.json#/$defs/FocusEvent"
    },
    "RobotLabTeleopEvent": {
      "$ref": "robotlab.json#/$defs/TeleopEvent"
    },
    "ActivityItem": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "name",
        "state",
        "started_at",
        "updated_at"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "goal": {
          "type": "string",
          "maxLength": 300
        },
        "profile": {
          "type": "string"
        },
        "step": {
          "type": "string"
        },
        "parent_id": {
          "type": "string"
        },
        "error": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "subagent",
            "task",
            "automation"
          ]
        },
        "state": {
          "enum": [
            "queued",
            "running",
            "waiting",
            "paused",
            "completed",
            "failed",
            "cancelled"
          ]
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "finished_at": {
          "type": "string",
          "format": "date-time"
        },
        "progress": {
          "$ref": "#/$defs/ActivityProgress"
        }
      }
    },
    "ActivityProgress": {
      "type": "object",
      "required": [
        "done",
        "total"
      ],
      "properties": {
        "done": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "ActivityUpdatedEvent": {
      "type": "object",
      "required": [
        "item"
      ],
      "properties": {
        "item": {
          "$ref": "#/$defs/ActivityItem"
        }
      }
    },
    "AutomationEvent": {
      "type": "object",
      "required": [
        "automation"
      ],
      "properties": {
        "automation": {
          "$ref": "automations.json#/$defs/Automation"
        }
      }
    },
    "AutomationRunEvent": {
      "type": "object",
      "required": [
        "run"
      ],
      "properties": {
        "run": {
          "$ref": "automations.json#/$defs/AutomationRun"
        }
      }
    },
    "AutomationDeletedEvent": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string"
        }
      }
    },
    "TaskUpdatedEvent": {
      "type": "object",
      "required": [
        "task"
      ],
      "properties": {
        "task": {
          "$ref": "task-reminder.json#/$defs/TaskSummary"
        }
      }
    },
    "ReminderEvent": {
      "type": "object",
      "required": [
        "reminder"
      ],
      "properties": {
        "reminder": {
          "$ref": "task-reminder.json#/$defs/Reminder"
        }
      }
    },
    "WhiteboardOpenedEvent": {
      "type": "object",
      "required": [
        "conversation_id",
        "board_id",
        "board",
        "layout"
      ],
      "properties": {
        "conversation_id": {
          "type": "string"
        },
        "board_id": {
          "type": "string"
        },
        "board": {
          "type": "object"
        },
        "layout": {
          "enum": [
            "panel",
            "fullscreen"
          ]
        }
      }
    },
    "WhiteboardOpsEvent": {
      "type": "object",
      "required": [
        "conversation_id",
        "board_id",
        "version",
        "ops",
        "author"
      ],
      "properties": {
        "conversation_id": {
          "type": "string"
        },
        "board_id": {
          "type": "string"
        },
        "version": {
          "type": "integer"
        },
        "ops": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "animate": {
          "type": "boolean"
        },
        "step_ms": {
          "type": "integer"
        },
        "author": {
          "enum": [
            "agent",
            "user"
          ]
        }
      }
    },
    "WhiteboardFocusEvent": {
      "type": "object",
      "required": [
        "conversation_id",
        "board_id",
        "version"
      ],
      "properties": {
        "conversation_id": {
          "type": "string"
        },
        "board_id": {
          "type": "string"
        },
        "version": {
          "type": "integer"
        },
        "ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rect": {
          "type": [
            "object",
            "null"
          ]
        },
        "zoom": {
          "type": "number"
        }
      }
    },
    "WhiteboardHighlightEvent": {
      "type": "object",
      "required": [
        "conversation_id",
        "board_id",
        "version",
        "ids",
        "style"
      ],
      "properties": {
        "conversation_id": {
          "type": "string"
        },
        "board_id": {
          "type": "string"
        },
        "version": {
          "type": "integer"
        },
        "ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "style": {
          "enum": [
            "laser",
            "pulse",
            "box"
          ]
        },
        "duration_ms": {
          "type": "integer"
        }
      }
    },
    "WhiteboardSnapshotRequestedEvent": {
      "type": "object",
      "required": [
        "conversation_id",
        "board_id",
        "request_id"
      ],
      "properties": {
        "conversation_id": {
          "type": "string"
        },
        "board_id": {
          "type": "string"
        },
        "request_id": {
          "type": "string"
        },
        "version": {
          "type": "integer"
        }
      }
    },
    "WhiteboardEvent": {
      "type": "object",
      "required": [
        "conversation_id",
        "board_id"
      ],
      "properties": {
        "conversation_id": {
          "type": "string"
        },
        "board_id": {
          "type": "string"
        }
      }
    },
    "MessageEvent": {
      "type": "object",
      "required": [
        "message_id",
        "conversation_id",
        "role",
        "text"
      ],
      "properties": {
        "message_id": {
          "type": "string"
        },
        "conversation_id": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceRef"
          }
        },
        "changes": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/FileChange"
          }
        },
        "relayed_by": {
          "type": "string"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "FileChange": {
      "type": "object",
      "required": [
        "path",
        "status",
        "added",
        "removed",
        "hunks"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "status": {
          "enum": [
            "added",
            "modified",
            "deleted"
          ]
        },
        "added": {
          "type": "integer",
          "minimum": 0
        },
        "removed": {
          "type": "integer",
          "minimum": 0
        },
        "hunks": {
          "type": "array",
          "maxItems": 40,
          "items": {
            "$ref": "#/$defs/FileHunk"
          }
        },
        "content": {
          "type": "string"
        },
        "truncated": {
          "type": "boolean"
        },
        "binary": {
          "type": "boolean"
        }
      }
    },
    "FileHunk": {
      "type": "object",
      "required": [
        "old_start",
        "old_lines",
        "new_start",
        "new_lines",
        "lines"
      ],
      "properties": {
        "old_start": {
          "type": "integer",
          "minimum": 0
        },
        "old_lines": {
          "type": "integer",
          "minimum": 0
        },
        "new_start": {
          "type": "integer",
          "minimum": 0
        },
        "new_lines": {
          "type": "integer",
          "minimum": 0
        },
        "lines": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[ +\\-]"
          }
        }
      }
    },
    "ConversationMessage": {
      "type": "object",
      "required": [
        "id",
        "conversation_id",
        "role",
        "text"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "conversation_id": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceRef"
          }
        },
        "changes": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/FileChange"
          }
        },
        "relayed_by": {
          "type": "string"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "SourceRef": {
      "type": "object",
      "required": [
        "n",
        "kind",
        "title"
      ],
      "properties": {
        "n": {
          "type": "integer",
          "minimum": 1
        },
        "kind": {
          "enum": [
            "document",
            "web"
          ]
        },
        "document_id": {
          "type": "string"
        },
        "chunk_id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "page_label": {
          "type": "string"
        },
        "paragraph": {
          "type": "integer",
          "minimum": 1
        },
        "section_path": {
          "type": "string"
        },
        "excerpt": {
          "type": "string",
          "maxLength": 300
        },
        "boxes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceBox"
          }
        },
        "mime": {
          "type": "string"
        },
        "blob_digest": {
          "type": "string"
        },
        "verbatim": {
          "type": "string"
        },
        "domain": {
          "type": "string"
        },
        "read_at": {
          "type": "string",
          "format": "date-time"
        },
        "tool": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      }
    },
    "SourceBox": {
      "type": "object",
      "required": [
        "page",
        "x0",
        "y0",
        "x1",
        "y1"
      ],
      "properties": {
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "x0": {
          "type": "number"
        },
        "y0": {
          "type": "number"
        },
        "x1": {
          "type": "number"
        },
        "y1": {
          "type": "number"
        }
      }
    },
    "ClassroomQuestionView": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "left": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "options": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "prompt": {
          "type": "string"
        },
        "right": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "kind",
        "prompt"
      ],
      "type": "object"
    },
