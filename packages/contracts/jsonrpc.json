{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://excalibur-agent/contracts/jsonrpc.json",
  "title": "Excalibur JSON-RPC 2.0 envelope",
  "description": "Wire envelope of the Excalibur gate. Exactly one of result/error is set on responses.",
  "defs": {
    "request": {
      "type": "object",
      "required": ["jsonrpc", "method"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "type": ["string", "number", "null"] },
        "method": { "type": "string", "minLength": 1 },
        "params": { "type": ["object", "array"] }
      },
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "required": ["jsonrpc", "id"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "type": ["string", "number", "null"] },
        "result": true,
        "error": { "$ref": "#/defs/error" }
      },
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "integer" },
        "message": { "type": "string" },
        "data": true
      },
      "additionalProperties": false
    },
    "cursor": {
      "type": "string",
      "description": "Opaque subscription position; empty resumes from now."
    },
    "event": {
      "type": "object",
      "required": ["seq", "id", "type", "at"],
      "properties": {
        "seq": { "type": "integer", "minimum": 0 },
        "id": { "type": "string" },
        "type": { "type": "string" },
        "at": { "type": "string", "format": "date-time" },
        "run_id": { "type": "string" },
        "task_id": { "type": "string" },
        "payload": { "type": "object" }
      },
      "additionalProperties": false
    }
  }
}
