    {"name": "automations.list", "family": "automations", "summary": "automations.list."},
    {"name": "automations.get", "family": "automations", "summary": "automations.get."},
    {"name": "automations.runs", "family": "automations", "summary": "automations.runs."},
    {"name": "automations.run", "family": "automations", "summary": "automations.run."},
    {"name": "automations.pause", "family": "automations", "summary": "automations.pause."},
    {"name": "automations.resume", "family": "automations", "summary": "automations.resume."},
    {"name": "automations.delete", "family": "automations", "summary": "automations.delete."}
  ],
  "$defs": {
    "Artifact": {
      "$ref": "events.json#/$defs/Artifact"
    },
    "ArtifactsGetParams": {
      "type": "object",
      "required": [
        "conversation_id",
        "run_id",
        "id"
      ],
      "properties": {
        "conversation_id": {
          "type": "string"
        },
        "run_id": {
          "type": "string"
        },
        "id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "ArtifactsGetResult": {
      "type": "object",
      "required": [
        "artifact",
        "content",
        "encoding",
        "source"
      ],
      "properties": {
        "artifact": {
          "$ref": "events.json#/$defs/Artifact"
        },
        "content": {
          "type": "string",
          "maxLength": 11184812
        },
        "encoding": {
          "enum": [
            "utf-8",
            "base64"
          ]
        },
        "source": {
          "type": "string",
          "maxLength": 1048576
        }
      }
    },
    "ArtifactsListParams": {
      "type": "object",
      "required": [
        "conversation_id"
      ],
      "properties": {
        "conversation_id": {
          "type": "string"
        },
        "run_id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "ArtifactsListResult": {
      "type": "object",
      "required": [
        "artifacts"
      ],
      "properties": {
        "artifacts": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "events.json#/$defs/Artifact"
          }
        }
      }
    },
    "ActivityItem": {"type": "object", "required": ["id", "kind", "name", "state", "started_at", "updated_at"], "properties": {"id": {"type": "string"}, "name": {"type": "string"}, "goal": {"type": "string", "maxLength": 300}, "profile": {"type": "string"}, "step": {"type": "string"}, "parent_id": {"type": "string"}, "error": {"type": "string"}, "kind": {"enum": ["subagent", "task", "automation"]}, "state": {"enum": ["queued", "running", "waiting", "paused", "completed", "failed", "cancelled"]}, "started_at": {"type": "string", "format": "date-time"}, "updated_at": {"type": "string", "format": "date-time"}, "finished_at": {"type": "string", "format": "date-time"}, "progress": {"$ref": "#/$defs/ActivityProgress"}}},
    "ActivityProgress": {"type": "object", "required": ["done", "total"], "properties": {"done": {"type": "integer", "minimum": 0}, "total": {"type": "integer", "minimum": 0}}},
    "ActivityUpdatedEvent": {"type": "object", "required": ["item"], "properties": {"item": {"$ref": "#/$defs/ActivityItem"}}},
    "ActivityListParams": {"type": "object", "required": ["conversation_id"], "properties": {"conversation_id": {"type": "string", "minLength": 1}}},
    "ActivityListResult": {"type": "object", "required": ["items"], "properties": {"items": {"type": "array", "maxItems": 50, "items": {"$ref": "#/$defs/ActivityItem"}}}},
    "FilesOpenParams": {"type": "object", "required": ["path"], "properties": {"path": {"type": "string", "minLength": 1}, "project_id": {"type": "string"}}},
    "FilesOpenResult": {"type": "object", "required": ["path", "mime", "kind", "size"], "properties": {"path": {"type": "string"}, "mime": {"type": "string"}, "content": {"type": "string"}, "document_id": {"type": "string"}, "blob_url": {"type": "string"}, "kind": {"enum": ["text", "document", "sheet", "image", "binary"]}, "size": {"type": "integer", "minimum": 0}}},

    "Element": {"type":"object","required":["id","type","x","y","author"],"properties":{"id":{"type":"string"},"type":{"enum":["rect","ellipse","diamond","line","arrow","text","freedraw","image","frame","math","mermaid","code","sticky"]},"x":{"type":"number"},"y":{"type":"number"},"width":{"type":"number"},"height":{"type":"number"},"z":{"type":"number"},"text":{"type":"string"},"latex":{"type":"string"},"mermaid":{"type":"string"},"code":{"type":"string"},"language":{"type":"string"},"src":{"type":"string"},"group_id":{"type":"string"},"frame_id":{"type":"string"},"points":{"type":"array","items":{"type":"array","minItems":2,"maxItems":2,"items":{"type":"number"}}},"style":{"type":"object","properties":{"stroke":{"type":"string"},"fill":{"type":"string"},"stroke_style":{"type":"string"},"font_family":{"type":"string"},"text_align":{"type":"string"},"stroke_width":{"type":"number"},"roughness":{"type":"number"},"font_size":{"type":"number"},"opacity":{"type":"number"}}},"locked":{"type":"boolean"},"author":{"enum":["agent","user"]},"start_binding":{"type":["object","null"]},"end_binding":{"type":["object","null"]}}},
    "Board": {"type":"object","required":["id","conversation_id","title","version","elements","updated_at"],"properties":{"id":{"type":"string"},"conversation_id":{"type":"string"},"title":{"type":"string"},"version":{"type":"integer"},"elements":{"type":"array","items":{"$ref":"#/$defs/Element"}},"viewport":{"type":"object","required":["x","y","zoom"],"properties":{"x":{"type":"number"},"y":{"type":"number"},"zoom":{"type":"number"}}},"updated_at":{"type":"string","format":"date-time"}}},
    "WhiteboardOp": {"type":"object","required":["op"],"properties":{"op":{"enum":["add","update","remove","clear","set_scene"]},"elements":{"type":"array","maxItems":500,"items":{"type":"object"}},"ids":{"type":"array","maxItems":500,"items":{"type":"string"}},"keep_user":{"type":"boolean"}}},
    "WhiteboardListParams": {"type":"object","required":[],"properties":{"conversation_id":{"type":"string"}}},
    "WhiteboardGetParams": {"type":"object","required":["board_id"],"properties":{"board_id":{"type":"string"}}},
    "WhiteboardCloseParams": {"type":"object","required":["board_id"],"properties":{"board_id":{"type":"string"}}},
    "WhiteboardSnapshotParams": {"type":"object","required":["board_id","image_blob"],"properties":{"board_id":{"type":"string"},"image_blob":{"type":"string"},"request_id":{"type":"string"}}},
    "WhiteboardApplyParams": {"type":"object","required":["board_id","base_version","ops","client_op_id"],"properties":{"board_id":{"type":"string"},"base_version":{"type":"integer","minimum":1},"client_op_id":{"type":"string"},"ops":{"type":"array","maxItems":500,"items":{"$ref":"#/$defs/WhiteboardOp"}}}},
    "WhiteboardApplyResult": {"type":"object","required":["version"],"properties":{"version":{"type":"integer"}}},
    "ClassroomQuestionView": {"additionalProperties":false,"properties":{"id":{"type":"string"},"kind":{"type":"string"},"left":{"items":{"type":"string"},"type":"array"},"options":{"items":{"type":"string"},"type":"array"},"prompt":{"type":"string"},"right":{"items":{"type":"string"},"type":"array"}},"required":["id","kind","prompt"],"type":"object"},
    "ClassroomQuizView": {"additionalProperties":false,"properties":{"course_id":{"type":"string"},"created_at":{"format":"date-time","type":"string"},"final":{"type":"boolean"},"id":{"type":"string"},"questions":{"items":{"$ref":"#/$defs/ClassroomQuestionView"},"type":"array"},"topic_id":{"type":"string"}},"required":["id","course_id","final","questions","created_at"],"type":"object"},
    "ClassroomClass": {"additionalProperties":false,"properties":{"content":{"type":"string"},"created_at":{"format":"date-time","type":"string"},"format":{"type":"string"},"whiteboard_id":{"type":"string"}},"required":["format","content","created_at"],"type":"object"},
    "ClassroomTopicView": {"additionalProperties":false,"properties":{"class":{"$ref":"#/$defs/ClassroomClass"},"completed_at":{"format":"date-time","type":"string"},"id":{"type":"string"},"status":{"type":"string"},"summary":{"type":"string"},"title":{"type":"string"}},"required":["id","title","summary","status"],"type":"object"},
    "ClassroomUnitView": {"additionalProperties":false,"properties":{"id":{"type":"string"},"title":{"type":"string"},"topics":{"items":{"$ref":"#/$defs/ClassroomTopicView"},"type":"array"}},"required":["id","title","topics"],"type":"object"},
    "ClassroomExamState": {"additionalProperties":false,"properties":{"passed":{"type":"boolean"},"passed_at":{"format":"date-time","type":"string"},"unlocked":{"type":"boolean"}},"required":["unlocked","passed"],"type":"object"},
    "ClassroomCourseView": {"additionalProperties":false,"properties":{"completed_at":{"format":"date-time","type":"string"},"created_at":{"format":"date-time","type":"string"},"final_exam":{"$ref":"#/$defs/ClassroomExamState"},"goal":{"type":"string"},"id":{"type":"string"},"language":{"type":"string"},"level":{"type":"string"},"progress":{"type":"integer"},"title":{"type":"string"},"units":{"items":{"$ref":"#/$defs/ClassroomUnitView"},"type":"array"},"updated_at":{"format":"date-time","type":"string"}},"required":["id","title","goal","level","language","units","final_exam","progress","created_at","updated_at"],"type":"object"},
    "ClassroomCourseSummary": {"additionalProperties":false,"properties":{"completed_topics":{"type":"integer"},"id":{"type":"string"},"progress":{"type":"integer"},"title":{"type":"string"},"total_topics":{"type":"integer"},"updated_at":{"format":"date-time","type":"string"}},"required":["id","title","progress","updated_at","total_topics","completed_topics"],"type":"object"},
    "ClassroomAnswer": {"additionalProperties":false,"properties":{"pairs":{"items":{"type":"integer"},"type":"array"},"question_id":{"type":"string"},"selected":{"items":{"type":"integer"},"type":"array"}},"required":["question_id"],"type":"object"},
    "ClassroomAnswerResult": {"additionalProperties":false,"properties":{"correct":{"type":"boolean"},"explanation":{"type":"string"},"question_id":{"type":"string"}},"required":["question_id","correct"],"type":"object"},
    "ClassroomAttemptView": {"additionalProperties":false,"properties":{"created_at":{"format":"date-time","type":"string"},"feedback":{"type":"string"},"id":{"type":"string"},"passed":{"type":"boolean"},"quiz_id":{"type":"string"},"results":{"items":{"$ref":"#/$defs/ClassroomAnswerResult"},"type":"array"}},"required":["id","quiz_id","results","passed","created_at"],"type":"object"},
    "ClassroomCourseParams": {"additionalProperties":false,"properties":{"course_id":{"type":"string"}},"required":["course_id"],"type":"object"},
    "ClassroomTopicParams": {"additionalProperties":false,"properties":{"course_id":{"type":"string"},"topic_id":{"type":"string"}},"required":["course_id","topic_id"],"type":"object"},
    "ClassroomSyllabusTopic": {"additionalProperties":false,"properties":{"id":{"type":"string"},"summary":{"type":"string"},"title":{"type":"string"}},"required":["title","summary"],"type":"object"},
    "ClassroomSyllabusUnit": {"additionalProperties":false,"properties":{"id":{"type":"string"},"title":{"type":"string"},"topics":{"items":{"$ref":"#/$defs/ClassroomSyllabusTopic"},"type":"array"}},"required":["title","topics"],"type":"object"},
    "ClassroomUpdateSyllabusParams": {"additionalProperties":false,"properties":{"course_id":{"type":"string"},"units":{"items":{"$ref":"#/$defs/ClassroomSyllabusUnit"},"type":"array"}},"required":["course_id","units"],"type":"object"},
    "ClassroomRequestQuizParams": {"additionalProperties":false,"properties":{"course_id":{"type":"string"},"final":{"type":"boolean"},"topic_id":{"type":"string"}},"required":["course_id"],"type":"object"},
    "ClassroomGetQuizParams": {"additionalProperties":false,"properties":{"quiz_id":{"type":"string"}},"required":["quiz_id"],"type":"object"},
    "ClassroomSubmitParams": {"additionalProperties":false,"properties":{"answers":{"items":{"$ref":"#/$defs/ClassroomAnswer"},"type":"array"},"quiz_id":{"type":"string"}},"required":["quiz_id","answers"],"type":"object"},
    "ClassroomAttemptsParams": {"additionalProperties":false,"properties":{"course_id":{"type":"string"},"topic_id":{"type":"string"}},"required":["course_id"],"type":"object"},
    "ClassroomListResult": {"additionalProperties":false,"properties":{"courses":{"items":{"$ref":"#/$defs/ClassroomCourseSummary"},"type":"array"}},"required":["courses"],"type":"object"},
    "ClassroomOpenTopicResult": {"additionalProperties":false,"properties":{"class":{"$ref":"#/$defs/ClassroomClass"},"topic":{"$ref":"#/$defs/ClassroomTopicView"}},"required":["topic"],"type":"object"},
    "ClassroomRequestQuizResult": {"additionalProperties":false,"properties":{"quiz":{"$ref":"#/$defs/ClassroomQuizView"},"requested":{"type":"boolean"}},"required":["requested"],"type":"object"},
    "ClassroomSubmitResult": {"additionalProperties":false,"properties":{"attempt":{"type":"string"},"passed":{"type":"boolean"},"results":{"items":{"$ref":"#/$defs/ClassroomAnswerResult"},"type":"array"}},"required":["attempt","passed","results"],"type":"object"},
    "ClassroomAttemptsResult": {"additionalProperties":false,"properties":{"attempts":{"items":{"$ref":"#/$defs/ClassroomAttemptView"},"type":"array"}},"required":["attempts"],"type":"object"},
    "ClassroomEvent": {"additionalProperties":false,"properties":{"attempt_id":{"type":"string"},"course_id":{"type":"string"},"final":{"type":"boolean"},"quiz_id":{"type":"string"},"topic_id":{"type":"string"}},"required":["course_id"],"type":"object"},
    "ClassroomCourseEvent": {"additionalProperties":false,"properties":{"attempt_id":{"type":"string"},"course":{"$ref":"#/$defs/ClassroomCourseView"},"course_id":{"type":"string"},"deleted":{"type":"boolean"},"final":{"type":"boolean"},"quiz_id":{"type":"string"},"topic_id":{"type":"string"}},"required":["course_id"],"type":"object"},
    "ClassroomClassReadyEvent": {"additionalProperties":false,"properties":{"attempt_id":{"type":"string"},"class":{"$ref":"#/$defs/ClassroomClass"},"course_id":{"type":"string"},"final":{"type":"boolean"},"quiz_id":{"type":"string"},"topic_id":{"type":"string"}},"required":["course_id","class"],"type":"object"},
    "ClassroomQuizReadyEvent": {"additionalProperties":false,"properties":{"attempt_id":{"type":"string"},"course_id":{"type":"string"},"final":{"type":"boolean"},"quiz":{"$ref":"#/$defs/ClassroomQuizView"},"quiz_id":{"type":"string"},"topic_id":{"type":"string"}},"required":["course_id","quiz"],"type":"object"},
    "ClassroomAttemptGradedEvent": {"additionalProperties":false,"properties":{"attempt_id":{"type":"string"},"course_id":{"type":"string"},"final":{"type":"boolean"},"passed":{"type":"boolean"},"quiz_id":{"type":"string"},"results":{"items":{"$ref":"#/$defs/ClassroomAnswerResult"},"type":"array"},"topic_id":{"type":"string"}},"required":["course_id","passed","results"],"type":"object"},
    "ClassroomFeedbackReadyEvent": {"additionalProperties":false,"properties":{"attempt_id":{"type":"string"},"course_id":{"type":"string"},"feedback":{"type":"string"},"final":{"type":"boolean"},"quiz_id":{"type":"string"},"topic_id":{"type":"string"}},"required":["course_id","feedback"],"type":"object"},
    "ClassroomTopicCompletedEvent": {"additionalProperties":false,"properties":{"attempt_id":{"type":"string"},"course_id":{"type":"string"},"final":{"type":"boolean"},"progress":{"type":"integer"},"quiz_id":{"type":"string"},"topic":{"$ref":"#/$defs/ClassroomTopicView"},"topic_id":{"type":"string"}},"required":["course_id","topic","progress"],"type":"object"},
    "AppContext": {"additionalProperties":false,"properties":{"app":{"type":"string"},"course_id":{"type":"string"},"topic_id":{"type":"string"}},"required":["app"],"type":"object"},
    "ConversationSendParams": {"additionalProperties":false,"properties":{"attachments":{"items":{"type":"string"},"type":"array"},"client_msg_id":{"type":"string"},"context":{"$ref":"#/$defs/AppContext"},"conversation_id":{"type":"string"},"reply_to":{"type":"string"},"text":{"type":"string"}},"required":["conversation_id","client_msg_id","text"],"type":"object"}
  }
}
