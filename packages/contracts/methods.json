    { "name": "skills.groups", "family": "skills", "summary": "List skill groups with localized labels and effective counts." },
    { "name": "skills.list", "family": "skills", "summary": "List the effective skill catalog with filters." },
    { "name": "skills.get", "family": "skills", "summary": "Read a complete skill source and diagnostics." },
    { "name": "skills.update", "family": "skills", "summary": "Validate and update a skill with a backup." },
