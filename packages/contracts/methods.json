    { "name": "vault.lock", "family": "vault", "summary": "Lock the vault." },
    { "name": "vault.unlock", "family": "vault", "summary": "Unlock the vault." },
    { "name": "vault.delete", "family": "vault", "summary": "Delete a secret entry after confirmation." },
    { "name": "question.answer", "family": "question", "summary": "Answer a pending blocking or non-blocking question." },
    { "name": "metrics.query", "family": "metrics", "summary": "Query token, cost and execution metrics." },
    { "name": "files.list", "family": "files", "summary": "Lazy paginated file listing honoring .gitignore." },
    { "name": "config.get", "family": "config", "summary": "Read configuration values." },
