  "$defs": {
    "CredentialRequest": {
      "$ref": "methods.json#/$defs/CredentialRequest"
    },
    "CredentialRequestedEvent": {
      "$ref": "methods.json#/$defs/CredentialsRequestedEvent"
    },
    "CredentialResolvedEvent": {
      "$ref": "methods.json#/$defs/CredentialsResolvedEvent"
    },
    "PendingParams": {
      "$ref": "methods.json#/$defs/CredentialsPendingParams"
    },
    "PendingResult": {
      "$ref": "methods.json#/$defs/CredentialsPendingResult"
    },
    "SubmitParams": {
      "$ref": "methods.json#/$defs/CredentialsSubmitParams"
    },
    "SubmitResult": {
      "$ref": "methods.json#/$defs/CredentialsOKResult"
    },
    "CancelParams": {
      "$ref": "methods.json#/$defs/CredentialsCancelParams"
    },
    "CancelResult": {
      "$ref": "methods.json#/$defs/CredentialsOKResult"
