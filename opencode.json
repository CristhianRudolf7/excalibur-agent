{
  "$schema": "https://opencode.ai/config.json",
  "model": "meta/muse-spark-1.3-contributor",
  "small_model": "meta/muse-spark-1.3-contributor",
  "autoupdate": false,
  "share": "disabled",
  "permission": {
    "*": "allow",
    "edit": "allow",
    "bash": "allow",
    "webfetch": "allow",
    "external_directory": "allow",
    "doom_loop": "allow"
  },
  "provider": {
    "meta": {
      "options": { "baseURL": "{env:EXC_META_BASE_URL}" },
      "models": {
        "muse-spark-1.3-contributor": {
          "options": { "reasoningEffort": "max", "reasoningSummary": "auto" }
        }
      }
    }
  }
}
